#!/bin/sh
types='build|chore|ci|docs|feat|fix|perf|refactor|style|test'
subject=$(grep -v '^#' "$1" | grep -v '^[[:space:]]*$' | head -n 1)
if printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9._/-]+\))?!?: [^[:space:]]"; then
  exit 0
fi
echo "commit message is not a conventional commit: $subject" >&2
echo "use '<type>[(scope)][!]: <subject>' with type one of: $types" >&2
exit 1
